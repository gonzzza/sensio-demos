{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Sync": {
    "Interval": "00:00:15",
    "DeadLetterAlertThreshold": 5,
    "BillingBaseUrl": "http://localhost:5080/mock/billing/",
    "CrmBaseUrl": "http://localhost:5080/mock/crm/"
  },
  "Alerts": {
    "SlackWebhookUrl": "",
    "DedupeWindow": "00:05:00"
  },
  "AllowedHosts": "*"
}
